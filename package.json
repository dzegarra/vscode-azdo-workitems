{
  "name": "vscode-azdo-workitems",
  "displayName": "Azure DevOps Work Items",
  "description": "List my Azure DevOps work items in the current iteration, create branches and pull requests following the team conventions.",
  "version": "0.1.0",
  "publisher": "abb-flow-ui",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://dev.azure.com/ABB-PAMA-BVL/Flow%20Digital%20Architecture/_git/User_Interface"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "azdoWorkItems",
          "title": "Azure Work Items",
          "icon": "media/workitems.svg"
        }
      ]
    },
    "views": {
      "azdoWorkItems": [
        {
          "type": "webview",
          "id": "azdoWorkItems.myItems",
          "name": "Current Iterations"
        }
      ]
    },
    "commands": [
      {
        "command": "azdoWorkItems.refresh",
        "title": "Refresh",
        "category": "Azure Work Items",
        "icon": "$(refresh)"
      },
      {
        "command": "azdoWorkItems.openIterationBoard",
        "title": "Open Iteration Board",
        "category": "Azure Work Items",
        "icon": "$(link-external)"
      },
      {
        "command": "azdoWorkItems.selectTeams",
        "title": "Select Teams",
        "category": "Azure Work Items",
        "icon": "$(organization)"
      },
      {
        "command": "azdoWorkItems.createBranch",
        "title": "Create Branch",
        "category": "Azure Work Items",
        "icon": "$(git-branch)"
      },
      {
        "command": "azdoWorkItems.createPullRequest",
        "title": "Create Pull Request",
        "category": "Azure Work Items",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "azdoWorkItems.openDetails",
        "title": "Show Work Item Details",
        "category": "Azure Work Items"
      },
      {
        "command": "azdoWorkItems.changeState",
        "title": "Change Work Item State",
        "category": "Azure Work Items"
      },
      {
        "command": "azdoWorkItems.addTask",
        "title": "Add Task to Work Item",
        "category": "Azure Work Items"
      },
      {
        "command": "azdoWorkItems.checkPullRequests",
        "title": "Check My Pull Requests Now",
        "category": "Azure Work Items"
      },
      {
        "command": "azdoWorkItems.openDependencyMap",
        "title": "Open Dependency Map",
        "category": "Azure Work Items",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "azdoWorkItems.checkout",
        "title": "Checkout Work Item Branch",
        "category": "Azure Work Items"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "azdoWorkItems.refresh",
          "when": "view == azdoWorkItems.myItems",
          "group": "navigation@1"
        },
        {
          "command": "azdoWorkItems.openDependencyMap",
          "when": "view == azdoWorkItems.myItems",
          "group": "navigation@2"
        },
        {
          "command": "azdoWorkItems.openIterationBoard",
          "when": "view == azdoWorkItems.myItems",
          "group": "navigation@3"
        },
        {
          "command": "azdoWorkItems.selectTeams",
          "when": "view == azdoWorkItems.myItems"
        }
      ],
      "commandPalette": [
        {
          "command": "azdoWorkItems.checkout",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Azure Work Items",
      "properties": {
        "azdoWorkItems.organization": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps organization. Leave empty to detect it from the 'origin' remote."
        },
        "azdoWorkItems.project": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps project. Leave empty to detect it from the 'origin' remote."
        },
        "azdoWorkItems.repository": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps Git repository. Leave empty to detect it from the 'origin' remote."
        },
        "azdoWorkItems.teams": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Teams whose current iteration is listed. Leave empty to list all the teams you belong to."
        },
        "azdoWorkItems.remote": {
          "type": "string",
          "default": "origin",
          "description": "Git remote pointing to Azure DevOps."
        },
        "azdoWorkItems.baseBranch": {
          "type": "string",
          "default": "develop",
          "description": "Branch new branches are created from and pull requests target."
        },
        "azdoWorkItems.filter.types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Product Backlog Item",
            "Bug"
          ],
          "description": "Work item types shown. Empty: all types. Also editable with the Type chips of the view."
        },
        "azdoWorkItems.filter.hiddenStates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Done",
            "Removed",
            "Closed"
          ],
          "description": "Work item states hidden. Also editable with the State chips of the view."
        },
        "azdoWorkItems.filter.hiddenPullRequestStates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "States of the main PR of the work items hidden (\"No PR\" for work items without PRs). Also editable with the PR chips of the view."
        },
        "azdoWorkItems.filter.hiddenPriorities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Priorities hidden (\"P1\" … \"P4\", or \"No priority\"). Also editable with the Priority chips of the view."
        },
        "azdoWorkItems.stateOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Done",
            "Ready to Test",
            "Committed",
            "In Progress",
            "Approved",
            "New",
            "To Do"
          ],
          "description": "Order in which the work items are sorted by state. Case, spaces and dashes are ignored. States not listed go last."
        },
        "azdoWorkItems.branchTypeByWorkItemType": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "Bug": "bugfix"
          },
          "description": "Branch prefix per work item type. Types not listed use 'feature'."
        },
        "azdoWorkItems.branchModules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "common",
            "devops",
            "fui-common",
            "fui-dashboard",
            "fui-devices",
            "fui-users",
            "fui-data-collection",
            "fui-calibration",
            "fui-admin",
            "fui-apps",
            "fui-common-apps",
            "fui-apps-xmv",
            "fui-apps-aga3",
            "fui-apps-aga7",
            "fui-apps-pid",
            "fui-apps-pulseacc",
            "fui-apps-cause-and-effect",
            "fui-apps-cause-and-effect-plus",
            "fui-apps-tfxlogger",
            "fui-apps-ngc",
            "fui-apps-xio",
            "fui-apps-modbus",
            "fui-apps-tfio",
            "fui-apps-artificial-lift",
            "fui-tag-library",
            "pmui-api",
            "pmui-auth",
            "pmui-dashboard",
            "pmui-diagnostics"
          ],
          "description": "Catalog of modules used in branch names: <type>/<module>/<id>-<slug>."
        },
        "azdoWorkItems.prFeatureNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "DevOps",
            "FUI Common",
            "FUI API Client",
            "FUI Dashboard",
            "FUI Devices",
            "FUI Users",
            "FUI Data Collection",
            "FUI Calibration",
            "FUI Administration",
            "FUI Factory Setup and Reset",
            "FUI Applications",
            "FUI Common Apps",
            "FUI AGA3",
            "FUI AGA7",
            "FUI PID",
            "FUI PulseAcc",
            "FUI API Liquid",
            "FUI Cause and Effect",
            "FUI Cause and Effect Plus",
            "FUI TFXLogger",
            "FUI XIO",
            "FUI Coriolis",
            "FUI ModBus",
            "FUI TFIO",
            "FUI XMV",
            "FUI NGC",
            "FUI Tag Library",
            "FUI Artificial Lift",
            "PMUI API Client",
            "PMUI Authentication",
            "PMUI Dashboard",
            "PMUI Diagnostics",
            "PMUI User Settings"
          ],
          "description": "Catalog of feature names used in PR titles: [ids] Feature Name: Description."
        },
        "azdoWorkItems.moduleToFeature": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "common": "FUI Common",
            "devops": "DevOps",
            "fui-common": "FUI Common",
            "fui-dashboard": "FUI Dashboard",
            "fui-devices": "FUI Devices",
            "fui-users": "FUI Users",
            "fui-data-collection": "FUI Data Collection",
            "fui-calibration": "FUI Calibration",
            "fui-admin": "FUI Administration",
            "fui-apps": "FUI Applications",
            "fui-common-apps": "FUI Common Apps",
            "fui-apps-xmv": "FUI XMV",
            "fui-apps-aga3": "FUI AGA3",
            "fui-apps-aga7": "FUI AGA7",
            "fui-apps-pid": "FUI PID",
            "fui-apps-pulseacc": "FUI PulseAcc",
            "fui-apps-cause-and-effect": "FUI Cause and Effect",
            "fui-apps-cause-and-effect-plus": "FUI Cause and Effect Plus",
            "fui-apps-tfxlogger": "FUI TFXLogger",
            "fui-apps-ngc": "FUI NGC",
            "fui-apps-xio": "FUI XIO",
            "fui-apps-modbus": "FUI ModBus",
            "fui-apps-tfio": "FUI TFIO",
            "fui-apps-artificial-lift": "FUI Artificial Lift",
            "fui-tag-library": "FUI Tag Library",
            "pmui-api": "PMUI API Client",
            "pmui-auth": "PMUI Authentication",
            "pmui-dashboard": "PMUI Dashboard",
            "pmui-diagnostics": "PMUI Diagnostics"
          },
          "description": "Feature name preselected in the PR title for each branch module."
        },
        "azdoWorkItems.linkBranchToWorkItem": {
          "type": "boolean",
          "default": true,
          "description": "Add the new branch to the work item's Development section."
        },
        "azdoWorkItems.stateOnBranchCreated": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "Product Backlog Item": "Committed",
            "Bug": "Committed"
          },
          "description": "State a work item is moved to when a branch is created for it, per work item type. Only applied to work items in New, Approved or To Do. Remove a type to disable it."
        },
        "azdoWorkItems.notifications.events": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "comments",
              "vote",
              "merged"
            ],
            "enumDescriptions": [
              "New comments from other people",
              "Votes of the reviewers (approved, waiting for author, rejected…)",
              "The PR is merged"
            ]
          },
          "uniqueItems": true,
          "default": [
            "comments",
            "vote",
            "merged"
          ],
          "description": "Events of the pull requests you created that show a notification. Empty: no notifications."
        },
        "azdoWorkItems.notifications.pollIntervalSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 30,
          "description": "How often your pull requests are checked, in seconds."
        },
        "azdoWorkItems.alerts.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show alerts on the work items with problems the team agreed to avoid."
        },
        "azdoWorkItems.alerts.workItemTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Product Backlog Item",
            "Bug"
          ],
          "description": "Work item types checked for alerts."
        },
        "azdoWorkItems.alerts.blockingTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Needs refinement",
            "Requirements",
            "UX feedback required",
            "Missing REST API",
            "Blocked",
            "PT Feedback Required"
          ],
          "description": "Tags meaning a work item cannot be completed yet: an alert is shown when a work item with one of them is started. Case is ignored."
        },
        "azdoWorkItems.alerts.pullRequestTaskPattern": {
          "type": "string",
          "default": "\\b(PR|pull request)\\b",
          "description": "Regular expression (case is ignored) recognizing the PR task among the tasks of a work item by its title."
        },
        "azdoWorkItems.alerts.requiredFields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "types",
              "fields"
            ],
            "properties": {
              "types": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Work item types"
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Only in these states. Empty: always"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Field names, as shown in Azure DevOps (or reference names)"
              }
            }
          },
          "default": [
            {
              "types": [
                "Product Backlog Item"
              ],
              "fields": [
                "Effort",
                "Effort in days"
              ]
            },
            {
              "types": [
                "Bug"
              ],
              "states": [
                "Ready to Test"
              ],
              "fields": [
                "Integrated in Build"
              ]
            }
          ],
          "description": "Fields that must have a value. Fields that do not exist in the project are ignored."
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^3.6.0"
  }
}
