{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "vscode-azdo-workitems",
  "metadata": {
    "description": "VS Code extension to work with the Azure DevOps Work Items of the current iteration: create branches and pull requests"
  },
  "root": "tools/vscode-azdo-workitems",
  "sourceRoot": "tools/vscode-azdo-workitems/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "tools/vscode-azdo-workitems",
        "command": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --sourcemap --outfile=dist/extension.js"
      },
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/package.json"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "tools/vscode-azdo-workitems",
        "command": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --sourcemap --outfile=dist/extension.js --watch"
      },
      "cache": false,
      "continuous": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "tools/vscode-azdo-workitems",
        "command": "tsc --noEmit -p tsconfig.json"
      },
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tsconfig.json"],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "tools/vscode-azdo-workitems",
        "command": "vitest run --config vitest.config.mts"
      },
      "inputs": ["{projectRoot}/src/**/*"],
      "cache": true
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "tools/vscode-azdo-workitems",
        "command": "vsce package --no-dependencies --allow-missing-repository --skip-license"
      },
      "outputs": ["{projectRoot}/*.vsix"],
      "cache": false
    }
  },
  "tags": ["type:tooling", "scope:root"]
}
